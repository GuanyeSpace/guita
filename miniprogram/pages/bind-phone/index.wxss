.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.icon-area {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E6, #FFE8D0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.icon-phone {
  font-size: 48rpx;
  color: #E98B4A;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 16rpx;
}
.desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}
.bind-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E98B4A, #F28C48);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(233, 139, 74, 0.3);
}
.bind-btn::after {
  border: none;
}
.bind-btn[loading] {
  opacity: 0.8;
}
.loading-box {
  margin-top: 32rpx;
}
.loading-text {
  font-size: 26rpx;
  color: #999999;
}
.error-box {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background-color: #FFF5F5;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}
.error-text {
  font-size: 24rpx;
  color: #D94F4F;
  text-align: center;
  line-height: 1.5;
}
.agreement {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #CCCCCC;
  text-align: center;
  line-height: 1.5;
}
