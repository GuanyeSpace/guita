/* pages/bind-phone/index.wxss */
.bind-phone-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--color-bg);
  padding: 60rpx;
  box-sizing: border-box;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-area {
  margin-bottom: 60rpx;
}

.phone-icon {
  width: 140rpx;
  height: 140rpx;
  opacity: 0.8;
}

.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  max-width: 520rpx;
}

.action-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bind-btn {
  width: 100%;
  height: 96rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.bind-btn:active {
  opacity: 0.85;
}

.error-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #FF4D4F;
}

.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  flex-wrap: wrap;
}

.agreement-row .link {
  color: var(--color-primary);
}
