.container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #F8F6F3;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}
.desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 64rpx;
}
.bind-btn {
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  background-color: #333333;
  border-radius: 8rpx;
  border: none;
}
.bind-btn::after {
  border: none;
}
.loading-box {
  margin-top: 40rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #999999;
}
.error-box {
  margin-top: 40rpx;
  padding: 20rpx 30rpx;
  background-color: #FFF5F5;
  border-radius: 8rpx;
}
.error-text {
  font-size: 26rpx;
  color: #D94F4F;
  text-align: center;
  line-height: 1.5;
}
.agreement {
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #CCCCCC;
  text-align: center;
  line-height: 1.5;
}
