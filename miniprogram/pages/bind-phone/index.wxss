.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.icon-area {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E6, #FFE8D0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.icon-phone {
  font-size: 48rpx;
  color: #E98B4A;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 16rpx;
}
.desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}
.bind-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E98B4A, #F28C48);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(233, 139, 74, 0.3);
}
.bind-btn::after {
  border: none;
}
.bind-btn[loading] {
  opacity: 0.8;
}
.loading-box {
  margin-top: 32rpx;
}
.loading-text {
  font-size: 26rpx;
  color: #999999;
}
.error-box {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background-color: #FFF5F5;
  border-radius: 12rpx;
  width: 100%;
  box-sizing: border-box;
}
.error-text {
  font-size: 24rpx;
  color: #D94F4F;
  text-align: center;
  line-height: 1.5;
}

/* ===== 协议勾选区 ===== */
.agreement-section {
  margin-bottom: 32rpx;
  width: 100%;
}
.agreement-shake {
  animation: shake 0.4s ease;
}
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-6rpx); }
}
.checkbox-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 8rpx 0;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #D0CCC5;
  border-radius: 6rpx;
  margin-right: 12rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.checkbox-checked {
  background-color: #F28C48;
  border-color: #F28C48;
}
.checkbox-icon {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
}
.agreement-text {
  font-size: 24rpx;
  color: #6E665E;
  line-height: 1.6;
  flex: 1;
}
.agreement-link {
  color: #F28C48;
  text-decoration: underline;
}
