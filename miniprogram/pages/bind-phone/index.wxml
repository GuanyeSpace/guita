<view class="container">
  <view class="card">
    <view class="icon-area">
      <text class="icon-phone">📱</text>
    </view>
    <text class="title">绑定手机号</text>
    <text class="desc">绑定手机号后即可使用归她\n查看直播回放和精选食谱</text>

    <button
      class="bind-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{loading}}"
      disabled="{{loading}}"
    >一键绑定手机号</button>

    <view wx:if="{{loading}}" class="loading-box">
      <text class="loading-text">正在绑定...</text>
    </view>

    <view wx:if="{{error}}" class="error-box">
      <text class="error-text">{{error}}</text>
    </view>

    <text class="agreement">点击上方按钮即表示同意《用户服务协议》</text>
  </view>
</view>
