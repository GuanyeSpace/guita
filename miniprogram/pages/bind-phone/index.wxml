<!-- pages/bind-phone/index.wxml -->
<view class="bind-phone-page">
  <view class="content">
    <view class="icon-area" bind:tap="_devTapHandler">
      <image class="phone-icon" src="/images/icons/customer-service.svg" mode="aspectFit" />
    </view>

    <!-- 开发模式提示 -->
    <view wx:if="{{devMode}}" class="dev-banner">
      <text class="dev-text">🔧 开发模式已开启</text>
    </view>

    <view class="title-area">
      <text class="title">绑定手机号</text>
      <text class="desc">为了帮你保存回放、食谱和后续服务记录，请先绑定手机号。</text>
    </view>

    <!-- 正式绑定按钮 -->
    <view class="action-area">
      <button
        wx:if="{{!devMode}}"
        class="bind-btn"
        loading="{{loading}}"
        disabled="{{loading}}"
        open-type="getPhoneNumber"
        bind:getphonenumber="onBindPhone"
      >
        一键绑定手机号
      </button>

      <!-- 开发模式：手动输入 -->
      <view wx:if="{{devMode}}" class="dev-input-area">
        <text class="dev-label">开发模式 — 手动输入手机号</text>
        <input
          class="dev-phone-input"
          type="number"
          maxlength="11"
          placeholder="请输入11位手机号"
          value="{{devPhone}}"
          bindinput="onDevPhoneInput"
        />
        <button
          class="bind-btn dev-bind-btn"
          loading="{{devLoading}}"
          disabled="{{devLoading || devPhone.length !== 11}}"
          bind:tap="onDevBindPhone"
        >
          {{devLoading ? '绑定中...' : '绑定手机号（开发模式）'}}
        </button>
      </view>

      <view wx:if="{{error}}" class="error-tip">{{error}}</view>

      <view class="agreement-row">
        <text>绑定即表示同意</text>
        <text class="link" bind:tap="onViewUserAgreement">《用户协议》</text>
        <text>和</text>
        <text class="link" bind:tap="onViewPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
