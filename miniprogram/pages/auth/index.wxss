.container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #F8F6F3;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.loading-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
}
.blocked-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
}
