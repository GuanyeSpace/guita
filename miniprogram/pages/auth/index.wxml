<!-- pages/auth/index.wxml -->
<view class="auth-page">
  <view class="auth-content">
    <!-- logo 区 -->
    <view class="logo-area">
      <image class="logo" src="/images/icons/usercenter.png" mode="aspectFit" />
      <text class="app-name">归她</text>
      <text class="slogan">运动陪伴，健康生活方式</text>
    </view>

    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="loading-area">
      <text class="loading-text">正在加载...</text>
    </view>

    <!-- 错误态 -->
    <view wx:if="{{error}}" class="error-area">
      <text class="error-text">{{error}}</text>
      <button wx:if="{{error === '刚刚网络有点慢，再试一次好么？'}}" class="retry-btn" bind:tap="onRetry">重新加载</button>
    </view>
  </view>
</view>
