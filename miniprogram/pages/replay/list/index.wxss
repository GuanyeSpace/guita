.container {
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.header {
  padding: 32rpx 0 20rpx;
}
.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 6rpx;
}
.header-desc {
  font-size: 24rpx;
  color: #CCCCCC;
}
.empty-box {
  padding: 120rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-text {
  font-size: 26rpx;
  color: #CCCCCC;
}
.card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.card-cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #E8F0FE, #F0F5FF);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.card-cover image {
  width: 100%;
  height: 100%;
}
.cover-text {
  font-size: 24rpx;
  color: #999999;
}
.card-body {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 4rpx;
  line-height: 1.3;
}
.card-desc {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.card-meta {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.meta-text {
  font-size: 20rpx;
  color: #CCCCCC;
}
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}
.tag {
  font-size: 20rpx;
  color: #E98B4A;
  background-color: #FFF3E6;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
}
.load-more {
  padding: 24rpx 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-text {
  font-size: 26rpx;
  color: #CCCCCC;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 44rpx;
}
