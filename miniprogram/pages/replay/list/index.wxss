/* ========================================
   归她 · 回放列表页
   ── 页面特有样式（公共样式见 styles/common.wxss）
   主色 #F28C48 / 页面背景 #FCFBF9
   ======================================== */

/* 容器微调 */
.container {
  min-height: 100vh;
  background-color: #FCFBF9;
}
.content {
  /* g-content-padded 已提供 padding: 0 40rpx */
}

/* 页面标题 */
.header {
  padding-top: 40rpx;
  padding-bottom: 32rpx;
}

/* ===== 游客引导态 ===== */
.guest-icon-area {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E6, #FFE8D0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.guest-icon {
  font-size: 48rpx;
}
.guest-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1F1B18;
  margin-bottom: 12rpx;
}
.guest-desc {
  display: block;
  font-size: 26rpx;
  color: #6E665E;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 24rpx;
}
.guest-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E98B4A, #F28C48);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(233, 139, 74, 0.3);
}
.guest-btn::after {
  border: none;
}
