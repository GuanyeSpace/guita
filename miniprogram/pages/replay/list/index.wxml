<scroll-view scroll-y class="g-container container">
  <!-- ===== 骨架屏 ===== -->
  <view wx:if="{{loading}}" class="g-skeleton">
    <view class="g-sk-section">
      <view class="g-sk-section-header">
        <view class="g-sk-line g-sk-line-mid"></view>
      </view>
      <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
        <view class="g-sk-card">
          <view class="g-sk-cover"></view>
          <view class="g-sk-card-body">
            <view class="g-sk-line g-sk-line-long"></view>
            <view class="g-sk-line g-sk-line-mid"></view>
            <view class="g-sk-line g-sk-line-short"></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- ===== 错误 ===== -->
  <view wx:elif="{{error}}" class="g-center">
    <text class="g-error-text">{{error}}</text>
    <button class="g-retry-btn" bindtap="onRetry">重试</button>
  </view>

  <!-- ===== 游客引导 ===== -->
  <view wx:elif="{{guest}}" class="g-center">
    <view class="guest-icon-area">
      <text class="guest-icon">🔒</text>
    </view>
    <text class="guest-title">登录后可按主播查看回放</text>
    <text class="guest-desc">绑定手机号并选择老师后，即可浏览直播回放列表</text>
    <button class="guest-btn" bindtap="onGoLogin">立即登录</button>
  </view>

  <!-- ===== 正常内容 ===== -->
  <view wx:else class="g-content-padded content">
    <!-- 页面标题 -->
    <view class="header">
      <view class="g-section-title-bar">
        <view class="g-section-accent"></view>
        <text class="g-section-title">直播回放</text>
      </view>
    </view>

    <!-- 空态 -->
    <view wx:if="{{list.length === 0}}" class="g-empty">
      <view class="g-empty-cover g-cover-ph-replay">
        <text class="g-empty-icon">▶</text>
      </view>
      <text class="g-empty-title">这位老师还没有回放</text>
      <text class="g-empty-desc">敬请期待</text>
    </view>

    <!-- 列表 -->
    <view wx:else>
      <view
        wx:for="{{list}}"
        wx:key="_id"
        class="g-content-card"
        hover-class="g-content-card-hover"
        data-id="{{item._id}}"
        bindtap="onTapItem"
      >
        <view class="g-cover g-cover-ph-replay">
          <image
            wx:if="{{item.cover_url && !item._coverError}}"
            src="{{item.cover_url}}"
            mode="aspectFill"
            class="g-cover-image"
            binderror="onCoverError"
            data-id="{{item._id}}"
          />
          <view wx:else class="g-cover-ph-center g-cover-ph-replay">
            <text class="g-cover-ph-icon">▶</text>
          </view>
          <view wx:if="{{item.displayDuration}}" class="g-cover-badge">{{item.displayDuration}}</view>
        </view>
        <view class="g-card-body">
          <text class="g-card-title">{{item.title}}</text>
          <text class="g-card-desc">{{item.description}}</text>
          <view class="g-card-tags">
            <text wx:if="{{item.tags && item.tags.length}}" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="g-card-tag">{{tag}}</text>
            <text class="g-card-meta">{{formatDate(item.published_at)}}</text>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="g-load-more">
        <text wx:if="{{loadingMore}}" class="g-load-more-text">正在加载更多...</text>
        <text wx:elif="{{!hasMore}}" class="g-load-more-text">已经到底了</text>
      </view>
    </view>

    <view class="g-bottom-safe"></view>
  </view>
</scroll-view>
