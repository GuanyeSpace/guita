<view class="container">
  <view wx:if="{{loading}}" class="center">
    <text class="status-text">正在加载回放...</text>
  </view>

  <view wx:elif="{{error}}" class="center">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <view wx:elif="{{inaccessible}}" class="center">
    <text class="error-text">该内容暂不可访问。</text>
    <button class="retry-btn" bindtap="onGoBack">返回</button>
  </view>

  <block wx:else>
    <!-- 视频区域 -->
    <view class="video-section">
      <video
        wx:if="{{videoSrc}}"
        class="video"
        src="{{videoSrc}}"
        controls
        object-fit="contain"
      />
      <view wx:else class="video-placeholder">
        <text class="placeholder-text">暂时无法播放该回放，请稍后再试。</text>
      </view>
    </view>

    <!-- 内容信息 -->
    <view class="info-section">
      <text class="title">{{detail.title}}</text>
      <text class="desc">{{detail.description}}</text>

      <view class="meta">
        <text class="meta-text">时长：{{formatDuration(detail.duration_sec)}}</text>
        <text class="meta-text">{{formatDate(detail.published_at)}}</text>
      </view>

      <view wx:if="{{detail.tags && detail.tags.length}}" class="tags">
        <text wx:for="{{detail.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
      </view>
    </view>
  </block>
</view>
