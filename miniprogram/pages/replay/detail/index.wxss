.container {
  min-height: 100vh;
  background-color: #F8F6F3;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 44rpx;
}

/* 竖屏视频区域 */
.video-section {
  width: 100%;
  background-color: #000000;
}
.video {
  width: 100%;
  height: 900rpx;
}
.video-placeholder {
  width: 100%;
  height: 900rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1A1A1A;
}
.placeholder-text {
  font-size: 28rpx;
  color: #999999;
}

/* 内容信息 */
.info-section {
  padding: 32rpx 32rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx 20rpx 0 0;
  margin-top: -20rpx;
  position: relative;
}
.title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.meta {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.meta-text {
  font-size: 24rpx;
  color: #999999;
}
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  font-size: 22rpx;
  color: #E98B4A;
  background-color: #FFF3E6;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
}

/* 免责声明 */
.disclaimer {
  padding: 16rpx 40rpx 48rpx;
  text-align: center;
}
.disclaimer-text {
  font-size: 20rpx;
  color: #CCCCCC;
  line-height: 1.5;
}
