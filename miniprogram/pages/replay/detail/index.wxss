.container {
  min-height: 100vh;
  background-color: #F8F6F3;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
}

/* 视频区域 */
.video-section {
  width: 100%;
  background-color: #000000;
}
.video {
  width: 100%;
  height: 420rpx;
}
.video-placeholder {
  width: 100%;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1A1A1A;
}
.placeholder-text {
  font-size: 28rpx;
  color: #999999;
}

/* 内容信息 */
.info-section {
  padding: 32rpx 40rpx;
}
.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  line-height: 1.4;
}
.desc {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.meta {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
  margin-bottom: 16rpx;
}
.meta-text {
  font-size: 24rpx;
  color: #999999;
}
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tag {
  font-size: 22rpx;
  color: #F28C48;
  background-color: #FFF3E6;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}
