/* pages/replay/list.wxss */
.replay-list-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 30rpx;
  padding-bottom: 40rpx;
}

.replay-card {
  display: flex;
  flex-direction: column;
}

.replay-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: var(--color-accent);
  margin-bottom: 20rpx;
}

.replay-info {
  display: flex;
  flex-direction: column;
}

.replay-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 10rpx;
}

.replay-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.replay-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.replay-duration {
  font-size: 22rpx;
  color: var(--color-primary);
}

.replay-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.load-more-btn {
  color: var(--color-primary);
}
