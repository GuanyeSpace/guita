<!-- pages/replay/detail.wxml -->
<view class="replay-detail-page">
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">正在加载...</text>
  </view>

  <view wx:elif="{{error}}" class="error-container">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bind:tap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{content}}">
    <view class="video-area">
      <video
        wx:if="{{content.asset_url || content.asset_file_id}}"
        class="video-player"
        src="{{content.asset_url}}"
        fileID="{{content.asset_file_id}}"
        controls
        autoplay="{{false}}"
        show-center-play-btn
        show-play-btn
        enable-progress-gesture
        bind:play="onPlay"
        bind:error="onVideoError"
      />
      <view wx:else class="video-placeholder">
        <text>暂无视频资源</text>
      </view>
    </view>

    <view class="content-section">
      <text class="detail-title">{{content.title}}</text>
      <view wx:if="{{content.tags && content.tags.length > 0}}" class="tag-list">
        <text wx:for="{{content.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
      </view>
      <text class="detail-desc">{{content.description}}</text>
      <view class="detail-meta">
        <text wx:if="{{content.duration_sec}}">时长：约{{content.duration_sec / 60}}分钟</text>
        <text>发布于：{{content.published_at}}</text>
      </view>
    </view>

    <view class="disclaimer">
      本小程序提供的内容仅作参考，不构成医疗建议。
    </view>
  </view>
</view>
