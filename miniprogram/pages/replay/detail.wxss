/* pages/replay/detail.wxss */
.replay-detail-page {
  min-height: 100vh;
  background: #000000;
}

.video-area {
  width: 100%;
  background: #000000;
}

.video-player {
  width: 100%;
  height: 420rpx;
}

.video-placeholder {
  width: 100%;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a1a;
  color: #666666;
  font-size: 28rpx;
}

.content-section {
  background: var(--color-bg);
  padding: 30rpx;
  border-radius: 24rpx 24rpx 0 0;
  margin-top: -20rpx;
  position: relative;
  min-height: 60vh;
}

.detail-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.detail-desc {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.detail-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}
