<view class="container">
  <view wx:if="{{loading}}" class="center">
    <text class="status-text">正在加载我的信息...</text>
  </view>

  <view wx:elif="{{error}}" class="center">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <view wx:elif="{{blocked}}" class="center">
    <text class="error-text">当前账号暂不可用，如有疑问请联系工作人员。</text>
  </view>

  <!-- ===== 游客引导（未绑定手机号） ===== -->
  <view wx:elif="{{guest}}" class="center">
    <view class="guest-icon-area">
      <text class="guest-icon">👤</text>
    </view>
    <text class="guest-title">登录后可使用完整功能</text>
    <text class="guest-desc">绑定手机号后即可查看个人信息、绑定老师</text>
    <button class="guest-btn" bindtap="onGoLogin">立即登录</button>
  </view>

  <block wx:else>
    <view class="page-title">我的</view>

    <!-- 用户卡片 -->
    <view class="card user-card">
      <view class="user-avatar">
        <text class="avatar-text">{{user.guita_id ? user.guita_id[0] : '?'}}</text>
      </view>
      <view class="user-info">
        <view class="info-row">
          <text class="label">归她 ID</text>
          <text class="value">{{user.guita_id || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">手机号</text>
          <text class="value">{{maskedPhone || '未绑定'}}</text>
        </view>
        <view class="info-row">
          <text class="label">账号状态</text>
          <text class="value status-active">正常</text>
        </view>
      </view>
      <button class="copy-btn" bindtap="onCopyGuitaId">复制</button>
    </view>

    <!-- 老师信息 -->
    <view class="section-title">我的老师</view>
    <view wx:if="{{host}}" class="card host-card">
      <view class="host-avatar" style="background-color: {{host.brand_color_accent || '#FFF3E6'}}">
        <text class="host-avatar-text">{{host.display_name[0] || '?'}}</text>
      </view>
      <view class="host-info">
        <text class="host-name">{{host.display_name}}</text>
        <text class="host-desc">{{host.description}}</text>
        <text class="host-target">适合：{{host.target_user}}</text>
      </view>
    </view>
    <view wx:else class="card no-host">
      <text class="no-host-text">暂未绑定老师</text>
      <button class="go-host-btn" bindtap="onGoHostSelect">去选择老师</button>
    </view>

    <!-- 帮助说明 -->
    <view class="section-title">帮助与说明</view>
    <view class="card help-card">
      <text class="help-text">当前版本暂不支持自行更换老师。</text>
      <text class="help-text">如需处理手机号、老师绑定或内容访问问题，请联系工作人员。</text>
    </view>
  </block>
</view>
