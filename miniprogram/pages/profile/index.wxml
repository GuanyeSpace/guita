<!-- pages/profile/index.wxml -->
<view class="profile-page">
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">正在加载...</text>
  </view>

  <view wx:elif="{{error && !user}}" class="error-container">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bind:tap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{user}}" class="content-wrap">
    <view class="user-card">
      <image class="user-avatar" src="{{user.avatar_url || '/images/avatar.png'}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{user.nickname || '用户'}}</text>
        <text class="guita-id">ID: {{user.guita_id}}</text>
      </view>
    </view>

    <view class="info-list">
      <view class="info-item">
        <text class="label">手机号</text>
        <text class="value">{{user.phone ? (user.phone.length === 11 ? user.phone.substring(0,3) + '****' + user.phone.substring(7) : user.phone) : '未绑定'}}</text>
      </view>
      <view class="info-item">
        <text class="label">绑定主播</text>
        <text class="value">{{host ? host.display_name : '未绑定'}}</text>
      </view>
      <view wx:if="{{host}}" class="info-item">
        <text class="label">主播简介</text>
        <text class="value desc">{{host.description}}</text>
      </view>
      <view class="info-item">
        <text class="label">注册时间</text>
        <text class="value">{{user.created_at}}</text>
      </view>
    </view>

    <view class="disclaimer">
      本小程序提供的内容仅作参考，不构成医疗建议。
    </view>

    <view class="version">
      <text>归她 MVP v1.0.0</text>
    </view>
  </view>
</view>
