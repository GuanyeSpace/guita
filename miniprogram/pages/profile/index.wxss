.container {
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  padding: 40rpx 0 24rpx;
}

/* 卡片通用 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
}
.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.user-info {
  flex: 1;
  margin-left: 24rpx;
}
.info-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 6rpx;
}
.info-row:last-child {
  margin-bottom: 0;
}
.label {
  font-size: 24rpx;
  color: #999999;
  width: 120rpx;
  flex-shrink: 0;
}
.value {
  font-size: 24rpx;
  color: #333333;
}
.status-active {
  color: #52C41A;
}
.copy-btn {
  width: 100rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #333333;
  background-color: #F5F5F5;
  border-radius: 6rpx;
  border: none;
  flex-shrink: 0;
}
.copy-btn::after {
  border: none;
}

/* 老师区域 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}
.host-card {
  display: flex;
  align-items: center;
}
.host-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.host-avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.host-info {
  flex: 1;
  margin-left: 20rpx;
}
.host-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}
.host-desc {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
  margin-bottom: 4rpx;
}
.host-target {
  font-size: 22rpx;
  color: #999999;
}

/* 未绑定老师 */
.no-host {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 28rpx;
}
.no-host-text {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 20rpx;
}
.go-host-btn {
  width: 280rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background-color: #333333;
  border-radius: 8rpx;
  border: none;
}
.go-host-btn::after {
  border: none;
}

/* 帮助区域 */
.help-card {
  padding: 24rpx 28rpx;
}
.help-text {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.help-text:last-child {
  margin-bottom: 0;
}
