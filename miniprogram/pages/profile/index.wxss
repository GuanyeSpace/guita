.container {
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 44rpx;
}

/* ===== 页面标题 ===== */
.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  padding: 32rpx 0 20rpx;
}

/* ===== 卡片通用 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
}
.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E6, #FFE8D0);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}
.user-avatar::after {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(233, 139, 74, 0.12);
}
.avatar-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #E98B4A;
}
.user-info {
  flex: 1;
  margin-left: 20rpx;
}
.info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 4rpx;
}
.info-row:last-child {
  margin-bottom: 0;
}
.label {
  font-size: 22rpx;
  color: #CCCCCC;
  width: 100rpx;
  flex-shrink: 0;
}
.value {
  font-size: 24rpx;
  color: #2C2C2C;
}
.status-active {
  color: #52C41A;
}
.copy-btn {
  width: 96rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: #E98B4A;
  background-color: #FFF3E6;
  border-radius: 28rpx;
  border: none;
  flex-shrink: 0;
}
.copy-btn::after {
  border: none;
}

/* ===== 模块标题 ===== */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 12rpx;
  margin-top: 4rpx;
}

/* ===== 老师卡片 ===== */
.host-card {
  display: flex;
  align-items: center;
}
.host-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}
.host-avatar::after {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(233, 139, 74, 0.12);
}
.host-avatar-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #E98B4A;
}
.host-info {
  flex: 1;
  margin-left: 20rpx;
}
.host-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 4rpx;
}
.host-desc {
  display: block;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.4;
  margin-bottom: 2rpx;
}
.host-target {
  font-size: 20rpx;
  color: #CCCCCC;
}

/* ===== 未绑定老师 ===== */
.no-host {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
}
.no-host-text {
  font-size: 24rpx;
  color: #CCCCCC;
  margin-bottom: 16rpx;
}
.go-host-btn {
  width: 260rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E98B4A, #F28C48);
  border-radius: 34rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(233, 139, 74, 0.25);
}
.go-host-btn::after {
  border: none;
}

/* ===== 帮助区域 ===== */
.help-card {
  padding: 20rpx 24rpx;
}
.help-text {
  display: block;
  font-size: 22rpx;
  color: #CCCCCC;
  line-height: 1.6;
  margin-bottom: 6rpx;
}
.help-text:last-child {
  margin-bottom: 0;
}
