/* pages/host-select/index.wxss */
.host-select-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 140rpx;
}

.header {
  padding: 50rpx 40rpx 30rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.host-list {
  padding: 0 30rpx;
}

.host-card {
  display: flex;
  align-items: center;
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.host-card.selected {
  border-color: var(--color-primary);
  background: var(--color-accent);
}

.host-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  flex-shrink: 0;
  background: var(--color-accent);
}

.host-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.host-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.host-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.host-target {
  font-size: 22rpx;
  color: var(--color-primary);
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 3rpx solid #DDDDDD;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-white);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 二次确认弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: var(--color-white);
  border-radius: 20rpx;
  padding: 50rpx 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 30rpx;
}

.modal-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: center;
  margin-bottom: 40rpx;
  white-space: pre-line;
}

.modal-buttons {
  display: flex;
  width: 100%;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--color-accent);
  color: var(--color-primary);
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 2rpx solid var(--color-primary);
}

.btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}
