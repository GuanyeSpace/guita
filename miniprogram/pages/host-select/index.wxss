.container {
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.content {
  padding-top: 48rpx;
  padding-bottom: 60rpx;
}
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 12rpx;
}
.desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 44rpx;
}
.host-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s;
}
.host-card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}
.avatar-ring {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(233, 139, 74, 0.2);
}
.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #E98B4A;
}
.card-body {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 6rpx;
}
.card-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 6rpx;
}
.card-target {
  font-size: 22rpx;
  color: #CCCCCC;
}
.card-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.submit-tip {
  text-align: center;
  margin-top: 40rpx;
}
