.container {
  min-height: 100vh;
  background-color: #F8F6F3;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.content {
  padding-top: 80rpx;
  padding-bottom: 60rpx;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin-bottom: 16rpx;
}
.desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
  padding: 0 20rpx;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
}
.host-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}
.card-body {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 6rpx;
}
.card-target {
  font-size: 24rpx;
  color: #999999;
}
.submit-tip {
  text-align: center;
  margin-top: 40rpx;
}
