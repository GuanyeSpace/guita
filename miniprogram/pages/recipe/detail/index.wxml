<view class="container">
  <view wx:if="{{loading}}" class="center">
    <text class="status-text">正在加载食谱...</text>
  </view>

  <view wx:elif="{{error}}" class="center">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <view wx:elif="{{inaccessible}}" class="center">
    <text class="error-text">该内容暂不可访问。</text>
    <button class="retry-btn" bindtap="onGoBack">返回</button>
  </view>

  <block wx:else>
    <view class="info-section">
      <text class="title">{{detail.title}}</text>
      <text class="desc">{{detail.description}}</text>

      <view wx:if="{{detail.tags && detail.tags.length}}" class="tags">
        <text wx:for="{{detail.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
      </view>

      <text wx:if="{{detail.published_at}}" class="date">{{formatDate(detail.published_at)}}</text>
    </view>

    <view class="file-section">
      <button wx:if="{{hasFile && !guest}}" class="file-btn" bindtap="onOpenFile">
        查看食谱文件
      </button>
      <view wx:elif="{{guest}}" class="guest-file-cta">
        <text class="guest-file-text">登录后可查看完整食谱文件</text>
        <button class="guest-file-btn" bindtap="onGoLogin">立即登录</button>
      </view>
      <text wx:else class="no-file">暂时没有可预览的食谱文件。</text>
    </view>

    <view class="disclaimer">
      <text class="disclaimer-text">本小程序提供的内容仅作参考，不构成医疗建议。</text>
    </view>
  </block>
</view>
