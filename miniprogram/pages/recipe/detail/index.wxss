.container {
  min-height: 100vh;
  background-color: #F8F6F3;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 8rpx;
}

/* 内容信息 */
.info-section {
  padding: 40rpx 40rpx 32rpx;
}
.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.desc {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.tag {
  font-size: 22rpx;
  color: #F28C48;
  background-color: #FFF3E6;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}
.date {
  font-size: 24rpx;
  color: #999999;
}

/* 文件区域 */
.file-section {
  padding: 32rpx 40rpx;
}
.file-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  background-color: #F28C48;
  border-radius: 8rpx;
  border: none;
  text-align: center;
}
.file-btn::after {
  border: none;
}
.no-file {
  font-size: 26rpx;
  color: #CCCCCC;
}
