/* pages/recipe/list.wxss */
.recipe-list-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 30rpx;
  padding-bottom: 40rpx;
}

.recipe-card {
  display: flex;
  align-items: center;
}

.recipe-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--color-accent);
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.recipe-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.recipe-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
}

.arrow {
  font-size: 36rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
  margin-left: 10rpx;
}

.load-more {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.load-more-btn {
  color: var(--color-primary);
}
