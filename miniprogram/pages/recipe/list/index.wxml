<view class="container">
  <view wx:if="{{loading}}" class="center">
    <text class="status-text">正在加载食谱...</text>
  </view>

  <view wx:elif="{{error}}" class="center">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <!-- ===== 游客引导 ===== -->
  <view wx:elif="{{guest}}" class="center">
    <view class="guest-icon-area">
      <text class="guest-icon">🔒</text>
    </view>
    <text class="guest-title">登录后可查看食谱</text>
    <text class="guest-desc">绑定手机号并选择老师后，即可浏览精选食谱列表</text>
    <button class="guest-btn" bindtap="onGoLogin">立即登录</button>
  </view>

  <block wx:else>
    <view class="header">
      <text class="header-title">食谱</text>
      <text class="header-desc">这里会展示你当前老师精选的食谱和饮食建议。</text>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty-box">
      <text class="empty-text">暂时还没有食谱。</text>
    </view>

    <view wx:else class="list">
      <view
        wx:for="{{list}}"
        wx:key="_id"
        class="card"
        data-id="{{item._id}}"
        bindtap="onTapItem"
      >
        <view class="card-cover">
          <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" />
          <text wx:else class="cover-text">食谱</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <text class="card-desc">{{item.description}}</text>
          <view wx:if="{{item.tags && item.tags.length}}" class="tags">
            <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
          </view>
          <text wx:if="{{item.published_at}}" class="card-date">{{formatDate(item.published_at)}}</text>
        </view>
      </view>

      <view class="load-more">
        <text wx:if="{{loadingMore}}" class="status-text">正在加载更多...</text>
        <text wx:elif="{{!hasMore}}" class="status-text">已经到底了。</text>
      </view>
    </view>
  </block>
</view>
