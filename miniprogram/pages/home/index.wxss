.container {
  min-height: 100vh;
  background-color: #F8F6F3;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.content {
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* ===== Hero 区域 ===== */
.hero-section {
  position: relative;
  background: linear-gradient(135deg, #FFF3E6 0%, #FDF6EE 50%, #FFF8F0 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 48rpx 32rpx 40rpx;
  margin: 0 -32rpx 32rpx;
  text-align: center;
}
.hero-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  position: relative;
}
.hero-avatar::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(233, 139, 74, 0.15);
}
.hero-avatar-text {
  font-size: 52rpx;
  font-weight: 600;
  color: #E98B4A;
}
.hero-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 8rpx;
}
.hero-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 4rpx;
}
.hero-target {
  display: block;
  font-size: 22rpx;
  color: #CCCCCC;
}

/* ===== 模块标题 ===== */
.section {
  margin-bottom: 32rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
}
.section-more {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* ===== 卡片 ===== */
.card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.card-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.card-cover image {
  width: 100%;
  height: 100%;
}
.replay-cover {
  background: linear-gradient(135deg, #E8F0FE, #F0F5FF);
}
.recipe-cover {
  background: linear-gradient(135deg, #FFF3E6, #FFF8F0);
}
.cover-placeholder {
  font-size: 24rpx;
  color: #999999;
}
.card-body {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 6rpx;
  line-height: 1.3;
}
.card-desc {
  font-size: 22rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.card-meta {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.meta-text {
  font-size: 20rpx;
  color: #CCCCCC;
}
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}
.tag {
  font-size: 20rpx;
  color: #E98B4A;
  background-color: #FFF3E6;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.empty-box {
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-text {
  font-size: 24rpx;
  color: #CCCCCC;
}
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 44rpx;
}
.bottom-safe {
  height: 32rpx;
}
