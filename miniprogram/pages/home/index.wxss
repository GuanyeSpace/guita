/* ========================================
   归她 · 首页
   ── 页面特有样式（公共样式见 styles/common.wxss）
   主色 #F28C48 / 页面背景 #FCFBF9
   ======================================== */

/* 容器微调 */
.container {
  min-height: 100vh;
  background-color: #FCFBF9;
}
.content {
  /* g-content-padded 已提供 padding: 0 40rpx */
}

/* ===== 顶部问候区 ===== */
.greeting {
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}
.greeting-eyebrow {
  display: block;
  font-size: 24rpx;
  color: #A8A099;
  margin-bottom: 8rpx;
}
.greeting-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1F1B18;
  line-height: 1.25;
  margin-bottom: 16rpx;
}
.greeting-sub {
  display: block;
  font-size: 26rpx;
  color: #6E665E;
  line-height: 1.5;
}
.greeting-host {
  color: #F28C48;
}

/* ===== 主播卡片（基于 g-card） ===== */
.teacher-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 56rpx;
}
.teacher-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.teacher-avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #D9722E;
}
.teacher-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.teacher-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1B18;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.teacher-desc {
  font-size: 24rpx;
  color: #6E665E;
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.teacher-tags {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* ===== 底部 ===== */
.disclaimer-divider {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}
.disclaimer {
  text-align: center;
  padding-bottom: 8rpx;
}
.disclaimer-text {
  font-size: 22rpx;
  color: #A8A099;
  line-height: 1.5;
}

/* ===== 骨架屏（页面特有布局） ===== */
.sk-greeting {
  padding-top: 40rpx;
  padding-bottom: 32rpx;
}
.sk-teacher {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 56rpx;
}
.sk-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #F2EEEA 25%, #E8E2DC 50%, #F2EEEA 75%);
  background-size: 200% 100%;
  animation: g-shimmer 1.4s ease-in-out infinite;
  flex-shrink: 0;
}
.sk-teacher-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
