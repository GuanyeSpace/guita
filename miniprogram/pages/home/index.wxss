/* ========================================
   归她 · 首页
   ── 页面特有样式（公共样式见 styles/common.wxss）
   主色 #F28C48 / 页面背景 #FCFBF9
   ======================================== */

/* 容器微调 */
.container {
  min-height: 100vh;
  background-color: #FCFBF9;
}
.content {
  /* g-content-padded 已提供 padding: 0 40rpx */
}

/* ===== 顶部问候区 ===== */
.greeting {
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}
.greeting-eyebrow {
  display: block;
  font-size: 24rpx;
  color: #A8A099;
  margin-bottom: 8rpx;
}
.greeting-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1F1B18;
  line-height: 1.25;
  margin-bottom: 16rpx;
}
.greeting-sub {
  display: block;
  font-size: 26rpx;
  color: #6E665E;
  line-height: 1.5;
}
.greeting-host {
  color: #F28C48;
}

/* ===== 主播卡片（基于 g-card） ===== */
.teacher-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 56rpx;
}
.teacher-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.teacher-avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #D9722E;
}
.teacher-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.teacher-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1B18;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.teacher-desc {
  font-size: 24rpx;
  color: #6E665E;
  line-height: 1.4;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.teacher-tags {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* ===== 底部 ===== */
.disclaimer-divider {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}
.disclaimer {
  text-align: center;
  padding-bottom: 8rpx;
}
.disclaimer-text {
  font-size: 22rpx;
  color: #A8A099;
  line-height: 1.5;
}

/* ===== 骨架屏（页面特有布局） ===== */
.sk-greeting {
  padding-top: 40rpx;
  padding-bottom: 32rpx;
}
.sk-teacher {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 56rpx;
}
.sk-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #F2EEEA 25%, #E8E2DC 50%, #F2EEEA 75%);
  background-size: 200% 100%;
  animation: g-shimmer 1.4s ease-in-out infinite;
  flex-shrink: 0;
}
.sk-teacher-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ===== 游客引导态 ===== */
.guest-icon-area {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF3E6, #FFE8D0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.guest-icon {
  font-size: 48rpx;
}
.guest-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1F1B18;
  margin-bottom: 12rpx;
}
.guest-desc {
  display: block;
  font-size: 26rpx;
  color: #6E665E;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  padding: 0 24rpx;
}
.guest-select-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #FFFFFF;
  background: linear-gradient(135deg, #E98B4A, #F28C48);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(233, 139, 74, 0.3);
}
.guest-select-btn::after {
  border: none;
}
.guest-divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 360rpx;
  margin: 32rpx 0;
}
.guest-divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #ECE8E2;
}
.guest-divider-text {
  font-size: 24rpx;
  color: #A8A099;
  margin: 0 20rpx;
}
.guest-login-btn {
  width: 360rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #F28C48;
  background-color: #FFFFFF;
  border: 1rpx solid #F28C48;
  border-radius: 44rpx;
}
.guest-login-btn::after {
  border: none;
}

/* ===== 游客浏览中：问候区 ===== */
.greeting-guest {
  /* 覆盖原有样式，稍弱化 */
}
.guest-tag {
  color: #F28C48;
  border-color: #F28C48;
}
.switch-host-link {
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 16rpx;
}
.switch-host-text {
  font-size: 24rpx;
  color: #F28C48;
}
