.container {
  min-height: 100vh;
  background-color: #FAF7F2;
}
.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.content {
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* ===== 顶部欢迎区 ===== */
.welcome-area {
  padding-top: 32rpx;
  padding-bottom: 24rpx;
}
.welcome-greeting {
  display: block;
  font-size: 26rpx;
  color: #BBBBBB;
  margin-bottom: 6rpx;
}
.welcome-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #2C2C2C;
  line-height: 1.3;
  margin-bottom: 10rpx;
}
.welcome-sub {
  display: block;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.5;
}

/* ===== 老师信息卡片 ===== */
.teacher-card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  align-items: center;
}
.teacher-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}
.teacher-avatar::after {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(233, 139, 74, 0.12);
}
.teacher-avatar-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #E98B4A;
}
.teacher-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.teacher-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 4rpx;
}
.teacher-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.5;
  margin-bottom: 2rpx;
}
.teacher-target {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-bottom: 10rpx;
}
.teacher-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 20rpx;
  color: #E98B4A;
  background-color: #FFF3E6;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* ===== 模块标题 ===== */
.section {
  margin-bottom: 28rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
}
.section-more {
  font-size: 26rpx;
  color: #E98B4A;
  padding: 8rpx 0;
}

/* ===== 卡片 ===== */
.card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.card:active {
  opacity: 0.92;
}
.card-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.card-cover image {
  width: 100%;
  height: 100%;
}
.replay-cover {
  background: linear-gradient(135deg, #EEF4FF, #F5F9FF);
}
.recipe-cover {
  background: linear-gradient(135deg, #FFF3E6, #FFF8F0);
}
.cover-placeholder {
  font-size: 24rpx;
  color: #AAAAAA;
}
.card-body {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 6rpx;
  line-height: 1.3;
}
.card-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.5;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.card-meta {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  align-items: center;
}
.meta-text {
  font-size: 22rpx;
  color: #BBBBBB;
}
.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}
.tag {
  font-size: 20rpx;
  color: #E98B4A;
  background-color: #FFF3E6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

/* ===== 空状态 ===== */
.empty-box {
  padding: 48rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-text {
  font-size: 26rpx;
  color: #CCCCCC;
}

/* ===== 加载 & 错误 ===== */
.status-text {
  font-size: 28rpx;
  color: #999999;
}
.error-text {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
.retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #DDDDDD;
  border-radius: 44rpx;
}

/* ===== 底部 ===== */
.bottom-safe {
  height: 160rpx;
}
.disclaimer {
  padding: 0 0 32rpx;
  text-align: center;
}
.disclaimer-text {
  font-size: 20rpx;
  color: #D0D0D0;
  line-height: 1.5;
}
