<scroll-view scroll-y class="container">
  <view wx:if="{{loading}}" class="center">
    <text class="status-text">正在加载首页...</text>
  </view>

  <view wx:elif="{{error}}" class="center">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <view wx:else class="content">
    <!-- ===== 顶部欢迎区 ===== -->
    <view class="welcome-area">
      <text class="welcome-greeting">欢迎回来</text>
      <text class="welcome-title">你的专属内容已准备好</text>
      <text class="welcome-sub">跟着 {{host.display_name}}，轻松查看回放与食谱</text>
    </view>

    <!-- ===== 老师信息卡片 ===== -->
    <view class="teacher-card">
      <view class="teacher-avatar" style="background-color: {{host.brand_color_accent || '#FFF3E6'}}">
        <text class="teacher-avatar-text">{{host.display_name[0] || '?'}}</text>
      </view>
      <view class="teacher-info">
        <text class="teacher-name">{{host.display_name}}</text>
        <text class="teacher-desc">{{host.description}}</text>
        <text class="teacher-target">适合：{{host.target_user}}</text>
        <view class="teacher-badge">已绑定老师</view>
      </view>
    </view>

    <!-- ===== 最新直播回放 ===== -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最新直播回放</text>
        <text class="section-more" bindtap="onViewAllReplays">查看全部 ›</text>
      </view>
      <view wx:if="{{replaysEmpty}}" class="empty-box">
        <text class="empty-text">暂时还没有直播回放。</text>
      </view>
      <view wx:else>
        <view
          wx:for="{{replays}}"
          wx:key="_id"
          class="card"
          data-id="{{item._id}}"
          bindtap="onTapReplay"
        >
          <view class="card-cover replay-cover">
            <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" />
            <text wx:else class="cover-placeholder">回放</text>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.title}}</text>
            <text class="card-desc">{{item.description}}</text>
            <view class="card-meta">
              <text wx:if="{{item.duration_sec > 0}}" class="meta-text">时长：{{formatDuration(item.duration_sec)}}</text>
              <text class="meta-text">{{formatDate(item.published_at)}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 精选食谱 ===== -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">精选食谱</text>
        <text class="section-more" bindtap="onViewAllRecipes">查看全部 ›</text>
      </view>
      <view wx:if="{{recipesEmpty}}" class="empty-box">
        <text class="empty-text">暂时还没有食谱。</text>
      </view>
      <view wx:else>
        <view
          wx:for="{{recipes}}"
          wx:key="_id"
          class="card"
          data-id="{{item._id}}"
          bindtap="onTapRecipe"
        >
          <view class="card-cover recipe-cover">
            <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" />
            <text wx:else class="cover-placeholder">食谱</text>
          </view>
          <view class="card-body">
            <text class="card-title">{{item.title}}</text>
            <text class="card-desc">{{item.description}}</text>
            <view wx:if="{{item.tags && item.tags.length}}" class="tags">
              <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 底部 ===== -->
    <view class="bottom-safe"></view>
    <view class="disclaimer">
      <text class="disclaimer-text">本小程序提供的内容仅作参考，不构成医疗建议。</text>
    </view>
  </view>
</scroll-view>
