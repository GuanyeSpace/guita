<!-- pages/home/index.wxml -->
<view class="home-page">
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">正在加载...</text>
  </view>

  <view wx:elif="{{error && !host}}" class="error-container">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bind:tap="onRetry">重新加载</view>
  </view>

  <view wx:else>
    <!-- 顶部：主播信息 -->
    <view class="host-header card">
      <image class="host-avatar" src="{{host.avatar_url || host.avatar_file_id || '/images/avatar.png'}}" mode="aspectFill" />
      <view class="host-info">
        <text class="host-name">{{host.display_name}}</text>
        <text class="host-desc">{{host.description}}</text>
      </view>
    </view>

    <!-- 模块1：最新直播回放 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最新直播回放</text>
        <text class="section-more" bind:tap="onMoreReplay">更多 ›</text>
      </view>
      <view wx:if="{{replays.length === 0}}" class="section-empty">
        <text class="empty-text">暂无回放内容</text>
      </view>
      <view wx:else class="content-list">
        <view wx:for="{{replays}}" wx:key="_id" class="content-card card" data-id="{{item._id}}" bind:tap="onReplayTap">
          <image class="content-cover" src="{{item.cover_url || item.cover_file_id || '/images/default-goods-image.png'}}" mode="aspectFill" />
          <view class="content-info">
            <text class="content-title">{{item.title}}</text>
            <text class="content-desc">{{item.description}}</text>
            <text class="content-duration" wx:if="{{item.duration_sec}}">时长：{{item.duration_sec > 3600 ? '超过1小时' : item.duration_sec / 60 + '分钟'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 模块2：精选食谱 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">精选食谱</text>
        <text class="section-more" bind:tap="onMoreRecipe">更多 ›</text>
      </view>
      <view wx:if="{{recipes.length === 0}}" class="section-empty">
        <text class="empty-text">暂无食谱内容</text>
      </view>
      <view wx:else class="content-list">
        <view wx:for="{{recipes}}" wx:key="_id" class="content-card card" data-id="{{item._id}}" bind:tap="onRecipeTap">
          <image class="content-cover" src="{{item.cover_url || item.cover_file_id || '/images/default-goods-image.png'}}" mode="aspectFill" />
          <view class="content-info">
            <text class="content-title">{{item.title}}</text>
            <text class="content-desc">{{item.description}}</text>
            <view wx:if="{{item.tags && item.tags.length > 0}}" class="tag-list">
              <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="disclaimer">
      本小程序提供的内容仅作参考，不构成医疗建议。
    </view>
  </view>
</view>
