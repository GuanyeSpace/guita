<scroll-view scroll-y class="g-container container">
  <!-- ===== 骨架屏 ===== -->
  <view wx:if="{{loading}}" class="g-skeleton">
    <!-- 问候骨架 -->
    <view class="sk-greeting">
      <view class="g-sk-line g-sk-line-short"></view>
      <view class="g-sk-line g-sk-line-long"></view>
      <view class="g-sk-line g-sk-line-mid"></view>
    </view>
    <!-- 主播卡片骨架 -->
    <view class="sk-teacher g-card">
      <view class="sk-avatar"></view>
      <view class="sk-teacher-info">
        <view class="g-sk-line g-sk-line-mid"></view>
        <view class="g-sk-line g-sk-line-long"></view>
      </view>
    </view>
    <!-- 回放区块骨架 -->
    <view class="g-sk-section">
      <view class="g-sk-section-header">
        <view class="g-sk-line g-sk-line-mid"></view>
      </view>
      <block wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="g-sk-card">
          <view class="g-sk-cover"></view>
          <view class="g-sk-card-body">
            <view class="g-sk-line g-sk-line-long"></view>
            <view class="g-sk-line g-sk-line-mid"></view>
            <view class="g-sk-line g-sk-line-short"></view>
          </view>
        </view>
      </block>
    </view>
    <!-- 食谱区块骨架 -->
    <view class="g-sk-section">
      <view class="g-sk-section-header">
        <view class="g-sk-line g-sk-line-mid"></view>
      </view>
      <block wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="g-sk-card">
          <view class="g-sk-cover"></view>
          <view class="g-sk-card-body">
            <view class="g-sk-line g-sk-line-long"></view>
            <view class="g-sk-line g-sk-line-mid"></view>
            <view class="g-sk-line g-sk-line-short"></view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- ===== 错误 ===== -->
  <view wx:elif="{{error}}" class="g-center">
    <text class="g-error-text">{{error}}</text>
    <button class="g-retry-btn" bindtap="onRetry">重试</button>
  </view>

  <!-- ===== 游客引导：未选主播 ===== -->
  <view wx:elif="{{guestNeedSelect}}" class="g-center">
    <view class="guest-icon-area">
      <text class="guest-icon">👩‍🏫</text>
    </view>
    <text class="guest-title">选择一位老师开始浏览</text>
    <text class="guest-desc">选择后可预览该老师的直播回放和食谱，无需登录</text>
    <button class="guest-select-btn" bindtap="onGoSelectHost">去选择老师</button>
    <view class="guest-divider">
      <view class="guest-divider-line"></view>
      <text class="guest-divider-text">或</text>
      <view class="guest-divider-line"></view>
    </view>
    <button class="guest-login-btn" bindtap="onGoLogin">登录以绑定老师</button>
  </view>

  <!-- ===== 内容区（游客/登录共用） ===== -->
  <view wx:else class="g-content-padded content">
    <!-- 顶部问候区 -->
    <view wx:if="{{!guest}}" class="greeting">
      <text class="greeting-eyebrow">欢迎回来</text>
      <text class="greeting-title">你的专属内容已准备好</text>
      <text class="greeting-sub">跟随 <text class="greeting-host">{{host.display_name}}</text>，轻松查看回放与食谱</text>
    </view>
    <view wx:else class="greeting greeting-guest">
      <text class="greeting-eyebrow">正在预览</text>
      <text class="greeting-title">{{host.display_name}} 的内容</text>
      <text class="greeting-sub">登录后可彻底绑定该老师</text>
    </view>

    <!-- 主播信息卡片 -->
    <view class="teacher-card g-card">
      <view class="teacher-avatar" style="background-color: {{host.brand_color_accent || '#FFF3E6'}}">
        <text class="teacher-avatar-text">{{host.display_name[0] || '?'}}</text>
      </view>
      <view class="teacher-info">
        <text class="teacher-name">{{host.display_name}}</text>
        <text class="teacher-desc">{{host.description}}</text>
        <view class="teacher-tags">
          <text class="g-tag">{{host.target_user}}</text>
          <text wx:if="{{!guest}}" class="g-tag g-tag-checked">✓ 已绑定</text>
          <text wx:else class="g-tag guest-tag">试用中</text>
        </view>
      </view>
      <view wx:if="{{guest}}" class="switch-host-link" bindtap="onSwitchHost">
        <text class="switch-host-text">换一个 ›</text>
      </view>
    </view>

    <!-- ===== 最新直播回放 ===== -->
    <view class="g-section">
      <view class="g-section-header" bindtap="onViewAllReplays">
        <view class="g-section-title-bar">
          <view class="g-section-accent"></view>
          <text class="g-section-title">最新直播回放</text>
        </view>
        <text class="g-section-more">查看全部 ›</text>
      </view>

      <!-- 空态 -->
      <view wx:if="{{replaysEmpty}}" class="g-empty">
        <view class="g-empty-cover g-cover-ph-replay">
          <text class="g-empty-icon">▶</text>
        </view>
        <text class="g-empty-title">老师还在准备内容</text>
        <text class="g-empty-desc">敬请期待</text>
      </view>

      <!-- 卡片列表 -->
      <view wx:else>
        <view
          wx:for="{{replays}}"
          wx:key="_id"
          class="g-content-card"
          hover-class="g-content-card-hover"
          data-id="{{item._id}}"
          bindtap="onTapReplay"
        >
          <view class="g-cover g-cover-ph-replay">
            <image
              wx:if="{{item.cover_url && !item._coverError}}"
              src="{{item.cover_url}}"
              mode="aspectFill"
              class="g-cover-image"
              binderror="onCoverError"
              data-id="{{item._id}}"
              data-type="replay"
            />
            <view wx:else class="g-cover-ph-center g-cover-ph-replay">
              <text class="g-cover-ph-icon">▶</text>
            </view>
            <view wx:if="{{item.displayDuration}}" class="g-cover-badge">{{item.displayDuration}}</view>
          </view>
          <view class="g-card-body">
            <text class="g-card-title">{{item.title}}</text>
            <text class="g-card-desc">{{item.description}}</text>
            <text class="g-card-meta">{{formatDate(item.published_at)}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 精选食谱 ===== -->
    <view class="g-section">
      <view class="g-section-header" bindtap="onViewAllRecipes">
        <view class="g-section-title-bar">
          <view class="g-section-accent"></view>
          <text class="g-section-title">精选食谱</text>
        </view>
        <text class="g-section-more">查看全部 ›</text>
      </view>

      <!-- 空态 -->
      <view wx:if="{{recipesEmpty}}" class="g-empty">
        <view class="g-empty-cover g-cover-ph-recipe">
          <text class="g-empty-icon">🍽</text>
        </view>
        <text class="g-empty-title">老师还在准备内容</text>
        <text class="g-empty-desc">敬请期待</text>
      </view>

      <!-- 卡片列表 -->
      <view wx:else>
        <view
          wx:for="{{recipes}}"
          wx:key="_id"
          class="g-content-card"
          hover-class="g-content-card-hover"
          data-id="{{item._id}}"
          bindtap="onTapRecipe"
        >
          <view class="g-cover g-cover-ph-recipe">
            <image
              wx:if="{{item.cover_url && !item._coverError}}"
              src="{{item.cover_url}}"
              mode="aspectFill"
              class="g-cover-image"
              binderror="onCoverError"
              data-id="{{item._id}}"
              data-type="recipe"
            />
            <view wx:else class="g-cover-ph-center g-cover-ph-recipe">
              <text class="g-cover-ph-icon">🍽</text>
            </view>
          </view>
          <view class="g-card-body">
            <text class="g-card-title">{{item.title}}</text>
            <text class="g-card-desc">{{item.description}}</text>
            <view wx:if="{{item.tags && item.tags.length}}" class="g-card-tags">
              <text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag" class="g-card-tag">{{tag}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 底部 ===== -->
    <view class="g-divider disclaimer-divider"></view>
    <view class="disclaimer">
      <text class="disclaimer-text">本小程序提供的内容仅作参考，不构成医疗建议。</text>
    </view>
    <view class="g-bottom-safe"></view>
  </view>
</scroll-view>
