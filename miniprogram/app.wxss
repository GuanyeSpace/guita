/* 全局样式 */
page {
  --color-primary: #F28C48;
  --color-accent: #FFF3E6;
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-muted: #999999;
  --color-bg: #FFF3E6;
  --color-white: #FFFFFF;
  --color-border: #F0F0F0;

  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 通用按钮 - 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #CCCCCC;
  color: #999999;
}

/* 通用按钮 - 次要按钮 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: var(--color-accent);
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: 2rpx solid var(--color-primary);
}

.btn-secondary:active {
  opacity: 0.85;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.4;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.6;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.loading-container .loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.error-container .error-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.error-container .retry-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 免责声明 */
.disclaimer {
  margin-top: 40rpx;
  padding: 20rpx 30rpx;
  background: var(--color-accent);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.5;
}

/* 协议链接行 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.agreement-row .link {
  color: var(--color-primary);
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: var(--color-accent);
  color: var(--color-primary);
  font-size: 22rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

/* button 重置 */
button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
